# ==============================================================================
# Environment Configuration Template - IT3180 Group 26
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=debug

# PostgreSQL Database Configuration (aligned with docker-compose.yaml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apartment_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=dev_only_secret

# Database Connection Strings (C++ libpq / libpqxx compatible)
DATABASE_URL=postgres://app_user:dev_only_secret@localhost:5432/apartment_db?sslmode=disable
DB_CONNECTION_STRING="host=localhost port=5432 dbname=apartment_db user=app_user password=dev_only_secret"
